# Optional. The easiest way to connect is the in-app Setup page (http://localhost:3000/setup).
# Anything set here overrides what was entered in the app. Copy to .env.local to use.

# --- Muse Wonder (required for the analysis) ------------------------------------
# Meta Model API key: dev.meta.ai -> API keys
MODEL_API_KEY=

# --- ColdIQ (the data; optional for CSV-only studies) ---------------------------
# login.coldiq.com/sign-up (300 free credits), then create an API key in the dashboard
COLDIQ_API_KEY=

# --- Safety ---------------------------------------------------------------------
# Password for the whole UI (any username). Set this before exposing the app via a tunnel.
# Shareable reports (/report/<token>) stay public: they contain aggregates only.
APP_PASSWORD=

# --- Advanced -------------------------------------------------------------------
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-wonder-1.0
COLDIQ_API_URL=https://api.coldiq.com
# 0 = no background enrichment (use the buttons instead)
ID_JOBS_ENABLED=1
